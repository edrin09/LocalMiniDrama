# ===== LocalMiniDrama 环境变量示例 =====
# 用法：复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交真实 Key。
#   cp .env.example .env

# ---- 数据库 ----
# SQLite 单文件。file: 相对路径按 backend/prisma 解析，
# ../../data/lmd.db 即项目根 data/lmd.db（与素材目录统一收纳）。
DATABASE_URL="file:../../data/lmd.db"

# ---- 服务 ----
# 后端端口；前端 Vite 默认 3013 并把 /api 代理到这里
PORT=5679
# 素材根目录（相对 backend 进程工作目录）
UPLOAD_DIR=../data/uploads

# ---- ffmpeg ----
# 必须是完整版 ffmpeg / ffprobe（需 libx264、aac、subtitles 滤镜）。
# 系统 PATH 里第一个 ffmpeg 可能是精简版，不支持 jpg/aac/滤镜，故建议写绝对路径。
# Windows 示例：C:\ffmpeg\bin\ffmpeg.exe
# macOS/Linux 示例：/usr/local/bin/ffmpeg
FFMPEG_PATH=""

# ---- AI 模型（必填）----
# Agnes：文本拆解 + 图像生成 + 视频生成
# 申请地址：https://api.agnes-ai.cn
AGNES_API_KEY="sk-your-key-here"
AGNES_BASE_URL="https://api.agnes-ai.cn/v1"

# ---- 火山引擎 TTS（可选）----
# 不填则降级：保留 AI 视频原声，或改用本地 Edge TTS。
VOLC_TTS_APP_ID=""
VOLC_TTS_TOKEN=""
VOLC_TTS_CLUSTER="volcano_tts"
# 音色 ID，留空使用服务默认音色
VOLC_TTS_VOICE_TYPE=""

# ---- 媒体公网地址（可选兜底）----
# 视频接口要求参考图为可公开访问的 http(s) 地址。
# 默认使用生图返回的远端 URL，无需配置；
# 仅当远端 URL 失效时，才用此地址拼接本地素材（如内网穿透 http://xxx.example.com）。
PUBLIC_BASE_URL=""
